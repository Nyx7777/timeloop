[gd_resource type="Resource" script_class="LevelDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://content/definitions/level_definition.gd" id="1_level"]
[ext_resource type="Script" path="res://content/definitions/unit_spawn_definition.gd" id="2_spawn"]

[sub_resource type="Resource" id="Resource_player"]
script = ExtResource("2_spawn")
unit_id = &"player"
definition_id = &"player_prototype"
team = &"player"
position = Vector2i(0, 7)
max_hp = 3
move_range = 3
attack_damage = 1

