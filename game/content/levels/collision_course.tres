[resource]
script = ExtResource("1_level")
level_id = &"collision_course"
display_name = "历史冲撞"
briefing = "历史中的敌人移动拥有目标格优先权。本体挡在终点时会沿移动方向被撞开。"
hint = "攻击会把未被击杀的敌人推后一格；本体造成历史外位移时，固定敌人从下一回合开始清醒。分身只是在还原历史位置时不会扰动。"
board_size = Vector2i(8, 8)
lives = 3
walls = Array[Vector2i]([Vector2i(1, 1), Vector2i(1, 2), Vector2i(1, 3), Vector2i(5, 4), Vector2i(5, 5), Vector2i(5, 6)])
holes = Array[Vector2i]([Vector2i(3, 6), Vector2i(3, 3), Vector2i(6, 1)])
spawns = Array[Resource]([SubResource("Resource_player"), SubResource("Resource_guard_01"), SubResource("Resource_guard_02"), SubResource("Resource_guard_03")])
rules = {
"crystallize_enabled": true,
"push_enabled": true
}
