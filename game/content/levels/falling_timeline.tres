[resource]
script = ExtResource("1_level")
level_id = &"falling_timeline"
display_name = "坠落时间线"
briefing = "空洞把战场切成危险通道。编排不同时间线的攻击方向，让过去的你把现在的敌人推入正确的空洞，同时避开历史冲撞。"
hint = "分身攻击同样保留原来的击退方向；目标格换成新的敌人时，伤害与击退仍会照常生效。"
board_size = Vector2i(8, 8)
lives = 3
walls = Array[Vector2i]([Vector2i(3, 1), Vector2i(3, 2), Vector2i(3, 5), Vector2i(3, 6), Vector2i(1, 3), Vector2i(6, 4)])
holes = Array[Vector2i]([Vector2i(1, 6), Vector2i(2, 4), Vector2i(5, 3), Vector2i(6, 1)])
spawns = Array[Resource]([SubResource("Resource_player"), SubResource("Resource_guard_01"), SubResource("Resource_guard_02"), SubResource("Resource_guard_03"), SubResource("Resource_guard_04")])
rules = {
"crystallize_enabled": true,
"push_enabled": true
}
