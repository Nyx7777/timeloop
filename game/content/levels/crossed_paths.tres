[resource]
script = ExtResource("1_level")
level_id = &"crossed_paths"
display_name = "双线交错"
briefing = "两名守卫分居通道两端。规划第一条时间线的站位和攻击，再主动固化，让两个自己同时推进。"
hint = "固化会立刻把当前行动写成分身。紫色边框是分身本回合的最终占位，本体不能停在那里。"
board_size = Vector2i(8, 8)
lives = 2
walls = Array[Vector2i]([Vector2i(2, 3), Vector2i(3, 3), Vector2i(4, 3), Vector2i(1, 5), Vector2i(5, 5), Vector2i(1, 6), Vector2i(5, 6)])
spawns = Array[Resource]([SubResource("Resource_player"), SubResource("Resource_guard_01"), SubResource("Resource_guard_02")])
rules = {
"crystallize_enabled": true,
"push_enabled": false
}
