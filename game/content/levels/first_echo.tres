[gd_resource type="Resource" script_class="LevelDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://content/definitions/level_definition.gd" id="1_level"]
[ext_resource type="Script" path="res://content/definitions/unit_spawn_definition.gd" id="2_spawn"]

[sub_resource type="Resource" id="Resource_player"]
script = ExtResource("2_spawn")
unit_id = &"player"
definition_id = &"player_prototype"
team = &"player"
position = Vector2i(0, 7)
max_hp = 2
move_range = 3
attack_damage = 2

[sub_resource type="Resource" id="Resource_guard"]
script = ExtResource("2_spawn")
unit_id = &"guard_01"
definition_id = &"guard_prototype"
team = &"enemy"
position = Vector2i(1, 5)
max_hp = 4
move_range = 1
attack_damage = 2

[resource]
script = ExtResource("1_level")
level_id = &"first_echo"
display_name = "留下第一个自己"
briefing = "守卫需要两次攻击才能击败。第一次失败会留下分身。"
hint = "移动到敌人旁边攻击，让下一条时间线的分身重复这次攻击。"
board_size = Vector2i(8, 8)
lives = 2
walls = Array[Vector2i]([Vector2i(2, 4), Vector2i(2, 5), Vector2i(2, 6)])
spawns = Array[Resource]([SubResource("Resource_player"), SubResource("Resource_guard")])
rules = {
"crystallize_enabled": false,
"push_enabled": false
}
