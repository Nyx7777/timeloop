[resource]
script = ExtResource("1_level")
level_id = &"push_calibration"
display_name = "推力校准"
briefing = "普通攻击若没有击杀敌人，会把它向远离你的方向推一格。把守卫推入时间空洞，可以立即消灭它。"
hint = "黑紫色漩涡是时间空洞。单位不会主动走入，但被攻击或撞击推入时会立刻死亡。"
board_size = Vector2i(8, 8)
lives = 2
walls = Array[Vector2i]([Vector2i(0, 4), Vector2i(1, 4), Vector2i(2, 4), Vector2i(4, 2), Vector2i(5, 2), Vector2i(6, 2)])
holes = Array[Vector2i]([Vector2i(1, 5), Vector2i(5, 3)])
