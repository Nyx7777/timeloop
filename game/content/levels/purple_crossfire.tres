[resource]
script = ExtResource("1_level")
level_id = &"purple_crossfire"
display_name = "紫色交火区"
briefing = "多个分身会按旧到新的顺序重演。避开紫色火线与时间排斥，在混乱中完成最后一次编排。"
hint = "紫色描边格是本回合分身的攻击目标；分身会误伤本体，也可能击杀后来站进原目标格的敌人。"
board_size = Vector2i(8, 8)
lives = 3
walls = Array[Vector2i]([Vector2i(2, 2), Vector2i(3, 2), Vector2i(4, 5), Vector2i(5, 5), Vector2i(6, 3), Vector2i(1, 6)])
spawns = Array[Resource]([SubResource("Resource_player"), SubResource("Resource_guard_01"), SubResource("Resource_guard_02"), SubResource("Resource_guard_03"), SubResource("Resource_guard_04")])
rules = {
"crystallize_enabled": true,
"push_enabled": false
}
